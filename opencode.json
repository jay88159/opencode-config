  "model": "moonshot/kimi-k2.5",
  "small_model": "moonshot/kimi-k2.5",
  "autoupdate": true,
  "share": "disabled",
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "enabled": false,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "tavily": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tavily-mcp"
      ],
      "enabled": false,
      "environment": {
        "TAVILY_API_KEY": "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",
        "DEFAULT_PARAMETERS": "{\"max_results\": 3, \"include_answer\": false, \"include_raw_content\": false, \"search_depth\": \"basic\"}"
      }
    }
  },
  "plugin": [
    "oh-my-openagent@latest"
  ]
}
