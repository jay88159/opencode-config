{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": {
      "~/Documents/**": "allow"
    }
  },
  "agent": {
    "doc-writing": {
      "description": "文档写作编导：协调 doc-researcher、doc-writer、doc-diagrammer、doc-reviewer 四个 subagent 完成文档写作",
      "mode": "primary",
      "model": "moonshot/kimi-k2.5",
      "prompt": "{file:./skills/doc-writing/SKILL.md}",
      "permission": {
        "edit": "deny",
        "question": "allow",
        "read": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": {
          "seo-audit": "allow",
          "doc-writing": "allow"
        }
      },
      "color": "#4CAF50"
    },
    "doc-researcher": {
      "description": "文档调研员：Web 搜索（全英文 query）、素材采集、引用整理",
      "mode": "subagent",
      "model": "moonshot/kimi-k2.5",
      "prompt": "{file:./skills/doc-researcher/SKILL.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": {
          "doc-researcher": "allow"
        }
      }
    },
    "doc-writer": {
      "description": "文档撰稿：正文写作、占位符管理、内容融合",
      "mode": "subagent",
      "model": "moonshot/kimi-k2.5",
      "prompt": "{file:./skills/doc-writer/SKILL.md}",
      "permission": {
        "bash": "deny",
        "read": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": {
          "seo-audit": "allow",
          "doc-writer": "allow",
          "file-writer": "allow"
        }
      }
    },
    "doc-diagrammer": {
      "description": "文档图表师：DrawIO 图表生成",
      "mode": "subagent",
      "model": "moonshot/kimi-k2.5",
      "prompt": "{file:./skills/doc-diagrammer/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "skill": {
          "*": "deny",
          "doc-diagrammer": "allow",
          "draw-io": "allow"
        }
      }
    },
    "doc-reviewer": {
      "description": "文档审校：质量检查、段落重写、最终润色",
      "mode": "subagent",
      "model": "moonshot/kimi-k2.5",
      "prompt": "{file:./skills/doc-reviewer/SKILL.md}\n\n---\n\n## 审校检查清单\n\n{file:./skills/doc-reviewer/references/writing-checklist.md}",
      "permission": {
        "bash": "deny",
        "read": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": {
          "seo-audit": "allow",
          "file-writer": "allow",
          "doc-reviewer": "allow"
        }
      }
    },
    "explore": {
      "model": "moonshot/kimi-k2.5"
    },
    "librarian": {
      "model": "moonshot/kimi-k2.5"
    },
    "oracle": {
      "model": "moonshot/kimi-k2.5"
    },
    "prometheus": {
      "model": "moonshot/kimi-k2.5"
    },
    "metis": {
      "model": "moonshot/kimi-k2.5"
    },
    "momus": {
      "model": "moonshot/kimi-k2.5"
    },
    "hephaestus": {
      "model": "moonshot/kimi-k2.5"
    },
    "atlas": {
      "model": "moonshot/kimi-k2.5"
    },
    "sisyphus": {
      "model": "moonshot/kimi-k2.5"
    },
    "multimodal-looker": {
      "model": "moonshot/kimi-k2.5"
    }
  },
  "provider": {
    "anthropic": {
